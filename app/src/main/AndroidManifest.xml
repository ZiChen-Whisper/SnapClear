<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 存储/媒体权限：API 33+ 使用细粒度媒体权限 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- API 31-32 仍需 READ_EXTERNAL_STORAGE -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- 通知权限：API 33+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 前台服务权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 精确闹钟权限：后台定时唤醒截图检测 -->
    <!-- SCHEDULE_EXACT_ALARM: API 31-32 自动授予；API 33+ 需用户授权 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- USE_EXACT_ALARM: API 33+ 自动授予，无需用户授权，使 canScheduleExactAlarms() 始终返回 true -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- WakeLock：闹钟唤醒时保持 CPU 运行直至检测完成 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 开机自启：重启后恢复截图监听 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 电池优化豁免：防止后台服务被系统杀死 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 全屏通知 Intent：在国产 ROM 上强制弹出通知，绕过后台通知抑制 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 提升持续通知（Android 16 Live Updates / ColorOS 16 流体云）：让截图通知在状态栏顶部实时显示 -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SnapClear"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 接收通知 Action 的拷贝删除请求 -->
            <intent-filter>
                <action android:name="com.snapclear.app.action.COPY_DELETE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 通知操作透明中转页：不展示主页，仅执行复制并拉起系统删除确认 -->
        <activity
            android:name=".notification.NotificationActionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.SnapClear.NotificationAction" />

        <!-- 截图详情二级菜单（由主页最近截图卡片经 OPPO 无缝动画启动） -->
        <activity
            android:name=".ScreenshotDetailActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SnapClear" />

        <!-- 关于二级页面（由主页 SnapClear 文字经 OPPO 无缝动画启动） -->
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SnapClear" />

        <!-- 截图监听前台服务（specialUse 类型无 6 小时超时限制） -->
        <service
            android:name=".screenshot.ScreenshotMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuous screenshot monitoring for clipboard management" />
        </service>

        <!--
            ColorOS 会冻结普通前台服务及其 MediaStore 回调。无障碍事件由系统主动
            投递，在 OPPO 截图浮层出现时唤醒进程并立即执行一次 MediaStore 检测。
            服务不读取窗口内容，只响应系统窗口集合变化与截图组件窗口状态事件。
        -->
        <service
            android:name=".screenshot.ScreenshotAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/screenshot_accessibility_service" />
        </service>

        <!-- 系统级 MediaStore 变化触发器：应用线程被冻结时仍可唤醒检测 -->
        <service
            android:name=".screenshot.ScreenshotContentJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- AlarmManager 定时唤醒截图检测 -->
        <receiver
            android:name=".screenshot.ScreenshotAlarmReceiver"
            android:exported="false" />

        <!-- 开机自启：重启后恢复截图监听服务 -->
        <receiver
            android:name=".screenshot.BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 通知 Action 广播接收器（仅供内部使用） -->
        <receiver
            android:name=".notification.NotificationActionReceiver"
            android:exported="false" />

        <!-- 流体云倒计时 AlarmManager tick 接收器（仅供内部使用） -->
        <receiver
            android:name=".notification.LiveUpdateTickReceiver"
            android:exported="false" />

        <!-- FileProvider：用于将缓存图片共享到剪贴板 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
